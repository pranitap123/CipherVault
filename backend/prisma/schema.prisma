generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model File{
    id String @id @default(uuid())
    ownerId String @map("owner_id")

    // v2 (current): "iv" holds the 12-byte GCM IV for the file content.
    // v1 (legacy, decrypt-only): "iv" holds the 16-byte CBC IV instead —
    // encVersion is what tells the code which interpretation applies.
    iv Bytes

    // Populated only for encVersion 2. Nullable so existing v1 rows (if any
    // pre-date this migration) don't need backfilled values they can't have.
    authTag Bytes? @map("auth_tag")
    wrappedKey Bytes? @map("wrapped_key")
    keyIv Bytes? @map("key_iv")
    keyAuthTag Bytes? @map("key_auth_tag")
    encVersion Int @default(1) @map("enc_version")

    filename String
    originalFilename String
    mimeType String @map("mime_type")
    sizeBytes BigInt @map("size_bytes")
    storagePath String @map("storage_path")
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

     @@map("files")
}

enum Role {
  USER
  ADMIN
}

model User{
  id String @id @default(uuid())
  email String @unique
  password String
  role Role @default(USER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
   
  
  auditLogs   AuditLog[]

  @@map("users")
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  resource   String?
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

